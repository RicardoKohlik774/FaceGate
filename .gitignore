# --- Secrets and local configuration (never commit) ---
.env
.env.*
!.env.example
recognition/config.toml

# --- Face data (never commit) ---
# Model files are downloaded by recognition/scripts/download_models.py
recognition/face_core/models/*.onnx
# Sample videos and enrolled faces contain real people
recognition/samples/
*.npy
*.mp4
*.avi

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- Web (Node) ---
node_modules/
web/dist/

# --- IDE and OS ---
# PyCharm's .idea/ is tracked on purpose; its own .idea/.gitignore hides the personal files.
.vscode/
# Claude Code's personal settings for this machine (CLAUDE.md is shared and stays tracked)
.claude/settings.local.json
Thumbs.db
.DS_Store

# --- Logs ---
*.log
