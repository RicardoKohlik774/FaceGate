# --- Secrets and local configuration (never commit) ---
.env
.env.*
!.env.example
recognition/config.toml

# --- Face data (never commit) ---
# Model files are downloaded by recognition/scripts/download_models.py
recognition/face_core/models/*.onnx
recognition/face_core/models/*.part
# Sample videos and enrolled faces contain real people
recognition/samples/
*.npy
*.mp4
*.avi

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- Web (Node) ---
node_modules/
web/dist/

# --- IDE and OS ---
# PyCharm's .idea/ is tracked on purpose; its own .idea/.gitignore hides the personal files.
.vscode/
# Working notes and AI assistant instructions stay on the development machine
CLAUDE.md
docs/PROGRESS.md
# Claude Code's personal settings for this machine
.claude/settings.local.json
Thumbs.db
.DS_Store

# --- Logs ---
*.log
