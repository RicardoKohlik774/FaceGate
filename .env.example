# Copy this file to ".env" and fill in real values.
# ".env" is in .gitignore and must never be committed.

# --- Database ---
DATABASE_URL=postgresql+psycopg://facegate:change-me@localhost:5432/facegate

# --- Backend security ---
# Signs login tokens (JWT). Any long random string.
JWT_SECRET=change-me
# Encrypts face embeddings in the database (Fernet key).
FACE_DATA_KEY=change-me

# --- BankID: "mock" = built-in fake login, "sandbox" = Bank iD sandbox ---
# Production is never used in this project.
BANKID_MODE=mock
BANKID_CLIENT_ID=
BANKID_CLIENT_SECRET=

# --- Payments: "mock" = built-in fake payment page, "stripe" = Stripe test mode ---
# Only test keys (sk_test_...) are allowed.
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
